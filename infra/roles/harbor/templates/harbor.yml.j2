# Cấu hình tối giản cho Harbor - dùng HTTP, không TLS, CHỈ phù hợp cho lab học tập.
# Production phải bật https (xem phần "hardening" trong docs/03-security.md).
hostname: {{ harbor_hostname }}

http:
  port: {{ harbor_http_port }}

harbor_admin_password: {{ harbor_admin_password }}

database:
  password: {{ harbor_db_password }}
  max_idle_conns: 100
  max_open_conns: 900

data_volume: {{ harbor_home }}/data

trivy:
  ignore_unfixed: false
  skip_update: false

jobservice:
  max_job_workers: 10
  job_loggers:
    - STD_OUTPUT
    - FILE

notification:
  webhook_job_max_retry: 3

log:
  level: info
  local:
    rotate_count: 50
    rotate_size: 200M
    location: /var/log/harbor

_version: 2.11.0

proxy:
  http_proxy:
  https_proxy:
  no_proxy:
  components:
    - core
    - jobservice
    - trivy
